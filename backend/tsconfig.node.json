{
  "compilerOptions": {
    /* Конфиги инструментов: исполняются в Node как ESM, в dist не попадают. */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["eslint.config.mts", "prisma.config.ts"]
}
